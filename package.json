{
  "name": "john-long-design-portfolio-theme",
  "version": "1.0.0",
  "description": "A clean and unique UX Design Portfolio WordPress theme built with Bootstrap 5",
  "main": "index.js",
  "scripts": {
    "sass": "sass assets/scss/main.scss assets/css/main.css --style=compressed --source-map",
    "sass:watch": "sass assets/scss/main.scss assets/css/main.css --watch --style=compressed --source-map",
    "js:build": "uglifyjs assets/js/main.js -o assets/js/main.min.js --compress --mangle --source-map",
    "js:lightbox": "uglifyjs assets/js/lightbox.js -o assets/js/lightbox.min.js --compress --mangle --source-map",
    "build": "npm run sass && npm run js:build && npm run js:lightbox",
    "watch": "concurrently \"npm run sass:watch\" \"chokidar 'assets/js/*.js' -c 'npm run js:build && npm run js:lightbox'\"",
    "dev": "npm run watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.92.1",
    "uglify-js": "^3.17.4"
  },
  "keywords": [
    "wordpress",
    "theme",
    "portfolio",
    "ux-design",
    "bootstrap",
    "scss"
  ],
  "author": "John Long",
  "license": "GPL-2.0-or-later",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "type": "commonjs"
}
